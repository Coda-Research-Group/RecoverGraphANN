diff --git a/hnswlib/hnswlib.h b/hnswlib/hnswlib.h
index 7ccfbba..41205dd 100644
--- a/hnswlib/hnswlib.h
+++ b/hnswlib/hnswlib.h
@@ -120,10 +120,121 @@ static bool AVX512Capable() {
 #include <vector>
 #include <iostream>
 #include <string.h>
+#include <algorithm>
+#include <cmath>
+#include <numeric>
 
 namespace hnswlib {
 typedef size_t labeltype;
 
+struct Heuristic2Statistics {
+    size_t count = 0;
+    double before_avg = 0.0;
+    double before_median = 0.0;
+    size_t before_min = 0;
+    size_t before_max = 0;
+    double before_stddev = 0.0;
+    double after_avg = 0.0;
+    double after_median = 0.0;
+    size_t after_min = 0;
+    size_t after_max = 0;
+    double after_stddev = 0.0;
+
+    static Heuristic2Statistics compute(const std::vector<std::pair<size_t, size_t>>& sizes) {
+        Heuristic2Statistics stats;
+        stats.count = sizes.size();
+        if (stats.count == 0) {
+            return stats;
+        }
+
+        // Extract before and after values
+        std::vector<size_t> before_values;
+        std::vector<size_t> after_values;
+        before_values.reserve(stats.count);
+        after_values.reserve(stats.count);
+        for (const auto& p : sizes) {
+            before_values.push_back(p.first);
+            after_values.push_back(p.second);
+        }
+
+        // Compute statistics for "before" values
+        if (!before_values.empty()) {
+            std::sort(before_values.begin(), before_values.end());
+            stats.before_min = before_values.front();
+            stats.before_max = before_values.back();
+            stats.before_avg = std::accumulate(before_values.begin(), before_values.end(), 0.0) / stats.count;
+            
+            // Median
+            if (stats.count % 2 == 0) {
+                stats.before_median = (before_values[stats.count / 2 - 1] + before_values[stats.count / 2]) / 2.0;
+            } else {
+                stats.before_median = before_values[stats.count / 2];
+            }
+            
+            // Standard deviation
+            double sum_sq_diff = 0.0;
+            for (size_t val : before_values) {
+                double diff = val - stats.before_avg;
+                sum_sq_diff += diff * diff;
+            }
+            stats.before_stddev = std::sqrt(sum_sq_diff / stats.count);
+        }
+
+        // Compute statistics for "after" values
+        if (!after_values.empty()) {
+            std::sort(after_values.begin(), after_values.end());
+            stats.after_min = after_values.front();
+            stats.after_max = after_values.back();
+            stats.after_avg = std::accumulate(after_values.begin(), after_values.end(), 0.0) / stats.count;
+            
+            // Median
+            if (stats.count % 2 == 0) {
+                stats.after_median = (after_values[stats.count / 2 - 1] + after_values[stats.count / 2]) / 2.0;
+            } else {
+                stats.after_median = after_values[stats.count / 2];
+            }
+            
+            // Standard deviation
+            double sum_sq_diff = 0.0;
+            for (size_t val : after_values) {
+                double diff = val - stats.after_avg;
+                sum_sq_diff += diff * diff;
+            }
+            stats.after_stddev = std::sqrt(sum_sq_diff / stats.count);
+        }
+
+        return stats;
+    }
+};
+
+struct AddPointMetrics {
+    size_t candidates_visited = 0;
+    size_t candidates_pruned = 0;
+    /** For each mutuallyConnectNewElement call: (top_candidates size at entry, selectedNeighbors size). */
+    std::vector<std::pair<size_t, size_t>> mutual_connect_sizes;
+    /** For each getNeighborsByHeuristic2 call: (good points count, not good points count). */
+    std::vector<std::pair<size_t, size_t>> heuristic_good_not_good_counts;
+
+    void reset() {
+        candidates_visited = 0;
+        candidates_pruned = 0;
+        mutual_connect_sizes.clear();
+        heuristic_good_not_good_counts.clear();
+    }
+
+    void add(const AddPointMetrics& other) {
+        candidates_visited += other.candidates_visited;
+        candidates_pruned += other.candidates_pruned;
+        mutual_connect_sizes.insert(mutual_connect_sizes.end(),
+            other.mutual_connect_sizes.begin(),
+            other.mutual_connect_sizes.end());
+        heuristic_good_not_good_counts.insert(heuristic_good_not_good_counts.end(),
+            other.heuristic_good_not_good_counts.begin(),
+            other.heuristic_good_not_good_counts.end());
+    }
+
+};
+
